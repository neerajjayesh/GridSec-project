/* ============================================================
   GridSec Sim — Dark Professional Theme
   gui/styles.qss
   ============================================================ */

/* ── Global ───────────────────────────────────────────────── */
QWidget {
    background-color: #1e1e2e;
    color: #e2e8f0;
    font-family: "Segoe UI", "Inter", "Ubuntu", sans-serif;
    font-size: 13px;
    selection-background-color: #7c3aed;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #1e1e2e;
}

/* ── Menu Bar ─────────────────────────────────────────────── */
QMenuBar {
    background-color: #13131f;
    color: #e2e8f0;
    border-bottom: 1px solid #2d2d44;
    padding: 2px 0px;
    spacing: 2px;
}
QMenuBar::item {
    padding: 5px 12px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #2d2d44;
}
QMenuBar::item:pressed {
    background-color: #7c3aed;
}

QMenu {
    background-color: #252535;
    border: 1px solid #3d3d5c;
    border-radius: 6px;
    padding: 4px 0px;
}
QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 4px;
    margin: 1px 4px;
}
QMenu::item:selected {
    background-color: #7c3aed;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #3d3d5c;
    margin: 3px 8px;
}

/* ── Tool Bar ─────────────────────────────────────────────── */
QToolBar {
    background-color: #1a1a2e;
    border-bottom: 1px solid #2d2d44;
    spacing: 4px;
    padding: 4px 8px;
}
QToolBar::separator {
    background-color: #3d3d5c;
    width: 1px;
    margin: 4px 6px;
}
QToolButton {
    background-color: transparent;
    color: #e2e8f0;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 500;
}
QToolButton:hover {
    background-color: #2d2d44;
    border-color: #4d4d6c;
}
QToolButton:pressed {
    background-color: #7c3aed;
    border-color: #7c3aed;
}
QToolButton:checked {
    background-color: #5b21b6;
    border-color: #7c3aed;
    color: #ffffff;
}

/* ── Status Bar ───────────────────────────────────────────── */
QStatusBar {
    background-color: #13131f;
    color: #94a3b8;
    border-top: 1px solid #2d2d44;
    font-size: 12px;
    padding: 2px 8px;
}
QStatusBar::item {
    border: none;
    padding: 0px 6px;
}

/* ── Panels ───────────────────────────────────────────────── */
QDockWidget {
    color: #e2e8f0;
    border: 1px solid #2d2d44;
}
QDockWidget::title {
    background-color: #252535;
    padding: 6px 10px;
    border-bottom: 1px solid #3d3d5c;
    font-weight: 600;
    text-align: left;
}
QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
}

/* ── Splitter ─────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #2d2d44;
}
QSplitter::handle:horizontal {
    width: 3px;
}
QSplitter::handle:vertical {
    height: 3px;
}
QSplitter::handle:hover {
    background-color: #7c3aed;
}

/* ── Scroll Bars ──────────────────────────────────────────── */
QScrollBar:vertical {
    background: #1e1e2e;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #3d3d5c;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #7c3aed;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #1e1e2e;
    height: 10px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #3d3d5c;
    border-radius: 5px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background: #7c3aed;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── Buttons ──────────────────────────────────────────────── */
QPushButton {
    background-color: #2d2d44;
    color: #e2e8f0;
    border: 1px solid #3d3d5c;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #3d3d5c;
    border-color: #7c3aed;
}
QPushButton:pressed {
    background-color: #7c3aed;
    border-color: #7c3aed;
    color: #ffffff;
}
QPushButton:disabled {
    background-color: #1e1e2e;
    color: #4a5568;
    border-color: #2d2d44;
}

/* Primary / accent button */
QPushButton#btn_run,
QPushButton#btnRun,
QPushButton[objectName*="run"] {
    background-color: #10b981;
    border-color: #10b981;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#btn_run:hover,
QPushButton#btnRun:hover {
    background-color: #059669;
}

/* Danger button */
QPushButton#btn_stop,
QPushButton#btnStop,
QPushButton[objectName*="stop"] {
    background-color: #ef4444;
    border-color: #ef4444;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#btn_stop:hover,
QPushButton#btnStop:hover {
    background-color: #dc2626;
}

/* Accent button */
QPushButton#btn_attack_enable {
    background-color: #7c3aed;
    border-color: #7c3aed;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#btn_attack_enable:checked {
    background-color: #ef4444;
    border-color: #ef4444;
}

/* ── Labels ───────────────────────────────────────────────── */
QLabel {
    color: #e2e8f0;
    background: transparent;
}
QLabel[objectName*="title"],
QLabel[class="section-title"] {
    color: #a78bfa;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}
QLabel[objectName*="value"] {
    color: #10b981;
    font-weight: 600;
    font-size: 14px;
}
QLabel#status_pmu_running  { color: #10b981; font-weight: 600; }
QLabel#status_pmu_stopped  { color: #ef4444; }
QLabel#status_proxy_active { color: #10b981; font-weight: 600; }
QLabel#status_proxy_idle   { color: #94a3b8; }
QLabel#status_attack_on    { color: #f59e0b; font-weight: 700; }
QLabel#status_attack_off   { color: #4a5568; }

/* ── Input Fields ─────────────────────────────────────────── */
QLineEdit {
    background-color: #13131f;
    color: #e2e8f0;
    border: 1px solid #3d3d5c;
    border-radius: 6px;
    padding: 5px 10px;
    selection-background-color: #7c3aed;
}
QLineEdit:focus {
    border-color: #7c3aed;
    background-color: #1a1a2e;
}
QLineEdit:disabled {
    color: #4a5568;
    border-color: #2d2d44;
}

QSpinBox,
QDoubleSpinBox {
    background-color: #13131f;
    color: #e2e8f0;
    border: 1px solid #3d3d5c;
    border-radius: 6px;
    padding: 4px 8px;
}
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #7c3aed;
}
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: #2d2d44;
    border: none;
    width: 16px;
}
QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #7c3aed;
}

QComboBox {
    background-color: #13131f;
    color: #e2e8f0;
    border: 1px solid #3d3d5c;
    border-radius: 6px;
    padding: 5px 10px;
    selection-background-color: #7c3aed;
}
QComboBox:focus {
    border-color: #7c3aed;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #94a3b8;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #252535;
    color: #e2e8f0;
    border: 1px solid #3d3d5c;
    border-radius: 6px;
    selection-background-color: #7c3aed;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 5px 10px;
    border-radius: 3px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #3d3d5c;
}

/* ── Sliders ──────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background: #2d2d44;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #7c3aed;
    border: 2px solid #a78bfa;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #a78bfa;
    border-color: #c4b5fd;
}
QSlider::sub-page:horizontal {
    background: #7c3aed;
    border-radius: 2px;
}

/* ── Check Box ────────────────────────────────────────────── */
QCheckBox {
    spacing: 8px;
    color: #e2e8f0;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #3d3d5c;
    border-radius: 4px;
    background: #13131f;
}
QCheckBox::indicator:checked {
    background: #7c3aed;
    border-color: #7c3aed;
}
QCheckBox::indicator:hover {
    border-color: #7c3aed;
}

/* ── Radio Buttons ────────────────────────────────────────── */
QRadioButton {
    spacing: 8px;
    color: #e2e8f0;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #3d3d5c;
    border-radius: 8px;
    background: #13131f;
}
QRadioButton::indicator:checked {
    background: #7c3aed;
    border-color: #7c3aed;
}

/* ── Tab Widget ───────────────────────────────────────────── */
QTabWidget::pane {
    background-color: #252535;
    border: 1px solid #3d3d5c;
    border-radius: 0px 6px 6px 6px;
}
QTabBar::tab {
    background-color: #1e1e2e;
    color: #94a3b8;
    border: 1px solid #2d2d44;
    border-bottom: none;
    border-radius: 6px 6px 0px 0px;
    padding: 6px 16px;
    margin-right: 2px;
    font-size: 12px;
}
QTabBar::tab:selected {
    background-color: #252535;
    color: #e2e8f0;
    border-color: #3d3d5c;
    border-bottom: 1px solid #252535;
}
QTabBar::tab:hover:!selected {
    background-color: #2d2d44;
    color: #e2e8f0;
}

/* ── Group Box ────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #3d3d5c;
    border-radius: 8px;
    margin-top: 14px;
    padding: 10px 8px 8px 8px;
    color: #a78bfa;
    font-weight: 600;
    font-size: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #a78bfa;
    background-color: #1e1e2e;
    border-radius: 4px;
}

/* ── Text Edit (Packet Log) ───────────────────────────────── */
QTextEdit,
QPlainTextEdit {
    background-color: #0d0d1a;
    color: #94a3b8;
    border: 1px solid #2d2d44;
    border-radius: 6px;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 12px;
    padding: 4px;
    selection-background-color: #7c3aed;
}

/* ── Graphics View (Canvas) ───────────────────────────────── */
QGraphicsView {
    background-color: #0f0f1e;
    border: 1px solid #2d2d44;
    border-radius: 4px;
}

/* ── List Widget (Node Palette) ───────────────────────────── */
QListWidget {
    background-color: #252535;
    color: #e2e8f0;
    border: 1px solid #2d2d44;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}
QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
    margin: 2px 0px;
}
QListWidget::item:selected {
    background-color: #7c3aed;
    color: #ffffff;
}
QListWidget::item:hover {
    background-color: #2d2d44;
}

/* ── Tree Widget (Topology) ───────────────────────────────── */
QTreeWidget {
    background-color: #252535;
    color: #e2e8f0;
    border: 1px solid #2d2d44;
    border-radius: 6px;
    outline: none;
}
QTreeWidget::item {
    padding: 4px 8px;
}
QTreeWidget::item:selected {
    background-color: #7c3aed;
    color: #ffffff;
}
QTreeWidget::item:hover {
    background-color: #2d2d44;
}
QHeaderView::section {
    background-color: #1e1e2e;
    color: #94a3b8;
    border: none;
    border-bottom: 1px solid #3d3d5c;
    padding: 5px 8px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

/* ── Frame (section containers) ──────────────────────────── */
QFrame#sectionFrame {
    background-color: #252535;
    border: 1px solid #3d3d5c;
    border-radius: 8px;
}

/* ── Progress Bar ─────────────────────────────────────────── */
QProgressBar {
    background-color: #2d2d44;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #7c3aed;
    border-radius: 4px;
}

/* ── Tooltip ──────────────────────────────────────────────── */
QToolTip {
    background-color: #252535;
    color: #e2e8f0;
    border: 1px solid #7c3aed;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── Stat Cards ───────────────────────────────────────────── */
QLabel#statValue {
    font-size: 22px;
    font-weight: 700;
    color: #a78bfa;
}
QLabel#statLabel {
    font-size: 11px;
    color: #64748b;
    text-transform: uppercase;
}

/* ── Palette Tree Widget ─────────────────────────────────── */
QTreeWidget {
    background-color: transparent;
    border: none;
    outline: 0;
    font-size: 12px;
}
QTreeWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
    margin: 1px 0;
}
QTreeWidget::item:hover {
    background-color: #2d2d44;
}
QTreeWidget::item:selected {
    background-color: #3d3d5c;
    color: #e2e8f0;
}
QTreeWidget::branch {
    background: transparent;
}
QTreeWidget::branch:has-siblings:!adjoins-item {
    border-image: none;
}
QTreeWidget::branch:has-siblings:adjoins-item {
    border-image: none;
}
QTreeWidget::branch:!has-children:!has-siblings:adjoins-item {
    border-image: none;
}

/* ── High-Risk Asset Badge ───────────────────────────────── */
QLabel#highRiskBadge {
    background-color: #fbbf24;
    color: #7f1d1d;
    font-weight: 700;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 4px;
}

/* ── Regional Uplink Toggle ──────────────────────────────── */
QPushButton#regionalUplinkBtn {
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: 600;
    font-size: 11px;
}
QPushButton#regionalUplinkBtn:checked {
    background-color: #065f46;
    color: #10b981;
    border: 1px solid #10b981;
}
QPushButton#regionalUplinkBtn:!checked {
    background-color: #1e1e2e;
    color: #64748b;
    border: 1px solid #3d3d5c;
}

/* ── Breaker State Toggle ────────────────────────────────── */
QPushButton#breakerStateBtn:checked {
    background-color: #7f1d1d;
    color: #ef4444;
    border: 1px solid #ef4444;
    border-radius: 4px;
    font-weight: 700;
}
QPushButton#breakerStateBtn:!checked {
    background-color: #065f46;
    color: #10b981;
    border: 1px solid #10b981;
    border-radius: 4px;
    font-weight: 700;
}
