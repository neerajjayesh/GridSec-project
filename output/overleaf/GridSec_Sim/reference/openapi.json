{
  "openapi": "3.0.3",
  "info": {
    "title": "GridSec Sim REST API",
    "version": "1.0.0",
    "description": "Describes the implemented core HTTP interface. Desktop API start convenience methods and remote attack hooks are not wired. Server request handling is serial; SSE can block other requests. No TLS is provided."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Core server default"
    },
    {
      "url": "http://127.0.0.1:18080",
      "description": "Documentation example"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "State"
    },
    {
      "name": "Records"
    },
    {
      "name": "Exports"
    },
    {
      "name": "Attacks"
    },
    {
      "name": "Events"
    },
    {
      "name": "Help"
    }
  ],
  "paths": {
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Get public status",
        "tags": [
          "State"
        ],
        "description": "Public endpoint; manager sim_running may be stale after GUI Stop. Counts are retained records, not lifetime totals.",
        "responses": {
          "200": {
            "description": "Successful callback result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "500": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      },
      "options": {
        "operationId": "optionsgetStatus",
        "summary": "CORS preflight",
        "security": [],
        "responses": {
          "204": {
            "description": "Allows GET, POST, OPTIONS; Authorization and Content-Type; origin *."
          }
        }
      }
    },
