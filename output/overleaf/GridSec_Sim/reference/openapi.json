    "/api/v1/events": {
      "get": {
        "operationId": "getEvents",
        "summary": "Subscribe to future attacked/dropped incident events",
        "tags": [
          "Events"
        ],
        "description": "Serial HTTPServer: this request can block all others and delay shutdown. Queue 100; no event IDs/replay. Keepalive comments roughly every 30 idle seconds. Disconnect before shutdown.",
        "responses": {
          "200": {
            "description": "SSE stream with incident event and JSON Incident data.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
