          }
        }
      }
    },
    "/api/v1/attack/enable": {
      "post": {
        "operationId": "enableAttack",
        "summary": "Invoke optional attack-enable hook",
        "tags": [
          "Attacks"
        ],
        "description": "Desktop does not install this hook. Without one, success is false. Invalid JSON becomes an empty object. Hook must validate type/parameters and coordinate threading; HTTP 200 alone does not confirm effect.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttackEnable"
              },
              "example": {
                "type": "NOISE",
                "params": {
                  "noise_std": 5
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hook result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttackEnableResult"
                }
              }
            }
          },
          "400": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "optionsenableAttack",
        "summary": "CORS preflight",
        "security": [],
        "responses": {
          "204": {
            "description": "Allows GET, POST, OPTIONS; Authorization and Content-Type; origin *."
          }
        }
      }
    },
    "/api/v1/attack/disable": {
      "post": {
        "operationId": "disableAttack",
        "summary": "Invoke optional attack-disable hook",
        "tags": [
          "Attacks"
        ],
        "description": "Returns success even if no hook is connected and nothing changes.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledgment, not proof of engine change",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttackDisableResult"
                }
              }
            }
          },
          "401": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "optionsdisableAttack",
        "summary": "CORS preflight",
        "security": [],
        "responses": {
          "204": {
            "description": "Allows GET, POST, OPTIONS; Authorization and Content-Type; origin *."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Process-global token generated with secrets.token_hex(16). Not a JWT. GET status and OPTIONS are public. Explicit disable_auth() disables enforcement."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      },
      "IntegrationFlags": {
        "type": "object",
        "properties": {
          "pcap": {
            "type": "boolean"
          },
          "syslog": {
            "type": "boolean"
          },
          "rest_api": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "Simulation": {
        "type": "object",
        "properties": {
          "sim_running": {
            "type": "boolean"
          },
          "session_id": {
            "type": "string"
          },
          "uptime_s": {
            "type": "integer"
          },
          "total_incidents": {
            "type": "integer"
          },
          "attacked": {
            "type": "integer"
          },
          "integrations": {
            "$ref": "#/components/schemas/IntegrationFlags"
          }
        },
        "additionalProperties": true
      },
      "Status": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Simulation"
          },
          {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "example": "GridSec Sim"
              },
              "version": {
                "type": "string",
                "example": "1.0.0"
              },
              "timestamp": {
                "type": "number"
              },
              "auth": {
                "type": "boolean"
              }
            },
            "required": [
              "tool",
              "version",
              "timestamp",
              "auth"
            ],
            "additionalProperties": true
          }
        ]
      },
      "Frame": {
        "type": "object",
        "description": "Serialized frame dictionary. Raw bytes are stringified by the manager; no base64 contract.",
        "additionalProperties": true
      },
      "Incident": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Eight-character UUID-derived identifier"
          },
          "timestamp": {
            "type": "number"
          },
          "timestamp_iso": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "src_ip": {
            "type": "string"
          },
          "dst_ip": {
            "type": "string"
          },
          "attack_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "clean",
              "attacked",
              "dropped",
              "invalid"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "INFO",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "description": {
            "type": "string"
          },
          "original_val": {
            "$ref": "#/components/schemas/Frame"
          },
          "modified_val": {
            "$ref": "#/components/schemas/Frame"
          }
        },
        "required": [
          "id",
          "timestamp",
          "timestamp_iso",
          "protocol",
          "status",
          "attack_type"
        ],
        "additionalProperties": true
      },
      "Packet": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "number"
          },
          "protocol": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "attack": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "dst": {
            "type": "string"
          },
          "len": {
            "type": "integer",
            "description": "Supplied raw payload length; zero on the current desktop ingestion path."
          }
        },
        "additionalProperties": true
      },
      "Incidents": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "incidents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Incident"
            }
          }
        },
        "required": [
          "count",
          "total",
          "incidents"
        ],
        "additionalProperties": true
      },
      "Packets": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "packets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Packet"
            }
          }
        },
        "required": [
          "count",
          "packets"
        ],
        "additionalProperties": true
      },
      "Topology": {
        "type": "object",
        "description": "Latest callback snapshot, possibly empty. For populated v2 documents see topology-v2.schema.json.",
        "additionalProperties": true
      },
      "AttacksSnapshot": {
        "type": "object",
        "description": "Callback-defined object. Desktop currently supplies total_packets, modified_packets, dropped_packets, not full attack configuration.",
        "additionalProperties": true
      },
      "AttackEnable": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Required nonempty type. Engine types: NOISE, RAMP, PULSE, FREQUENCY_OVERRIDE, MAGNITUDE_OVERRIDE, ANGLE_OVERRIDE, REPLAY, DELAY, DROP, SCALE, NONE. The HTTP layer does not validate enum membership."
          },
          "params": {
            "type": "object",
            "additionalProperties": true,
            "example": {
