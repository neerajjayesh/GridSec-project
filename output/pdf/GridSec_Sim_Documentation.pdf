              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "attachment; filename=\"gridsec_stix2.json\""
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StixBundle"
                }
              }
            }
          },
          "401": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "optionsexportStix",
        "summary": "CORS preflight",
        "security": [],
        "responses": {
          "204": {
            "description": "Allows GET, POST, OPTIONS; Authorization and Content-Type; origin *."
          }
        }
      }
    },
    "/api/v1/export/csv": {
      "get": {
        "operationId": "exportCsv",
        "summary": "Nine-column incident summary, including clean records.",
        "tags": [
