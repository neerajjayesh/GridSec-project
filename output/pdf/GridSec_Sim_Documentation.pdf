    "/api/v1/incidents": {
      "get": {
        "operationId": "getIncidents",
        "summary": "Read retained incidents",
        "tags": [
          "Records"
        ],
        "description": "Returns last N in chronological order. Manager retains 10,000 entries. No cursor or durable history.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100
            },
            "description": "Use a positive integer. Implementation does not enforce bounds; zero returns all retained entries, negative values have Python slicing behavior; nonintegers can yield 500."
          },
          {
            "name": "proto",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Known defect: handler checks proto, but manager records use protocol. Nonempty filter returns no standard-manager matches. Omit and filter client-side."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful callback result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Incidents"
                }
              }
            }
          },
          "401": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "optionsgetIncidents",
        "summary": "CORS preflight",
        "security": [],
        "responses": {
          "204": {
            "description": "Allows GET, POST, OPTIONS; Authorization and Content-Type; origin *."
          }
        }
      }
    },
    "/api/v1/packets/recent": {
      "get": {
        "operationId": "getPackets",
        "summary": "Read retained packet summaries",
        "tags": [
          "Records"
        ],
        "description": "Manager retains 1,000 summaries.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50
            },
            "description": "Use a positive integer. Implementation does not enforce bounds; zero returns all retained entries, negative values have Python slicing behavior; nonintegers can yield 500."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful callback result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Packets"
                }
              }
            }
          },
          "401": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "optionsgetPackets",
        "summary": "CORS preflight",
        "security": [],
        "responses": {
          "204": {
            "description": "Allows GET, POST, OPTIONS; Authorization and Content-Type; origin *."
          }
        }
      }
    },
    "/api/v1/export/stix": {
      "get": {
        "operationId": "exportStix",
        "summary": "Experimental STIX export; observed-data limited to latest 20 attacked incidents.",
        "tags": [
          "Exports"
        ],
        "responses": {
          "200": {
            "description": "Attachment: gridsec_stix2.json",
