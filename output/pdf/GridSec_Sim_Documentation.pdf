        ],
        "responses": {
          "200": {
            "description": "Attachment: gridsec_incidents.csv",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "attachment; filename=\"gridsec_incidents.csv\""
              }
            },
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
