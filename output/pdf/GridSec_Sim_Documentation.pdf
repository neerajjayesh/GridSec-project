          "204": {
            "description": "Allows GET, POST, OPTIONS; Authorization and Content-Type; origin *."
          }
        }
      }
    },
    "/api/v1/export/pcap": {
      "get": {
        "operationId": "exportPcap",
        "summary": "Requires an available PCAP file. Desktop start and byte-delivery paths are incomplete.",
        "tags": [
          "Exports"
        ],
        "responses": {
          "200": {
            "description": "Attachment: gridsec_capture.pcap",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "attachment; filename=\"gridsec_capture.pcap\""
              }
            },
            "content": {
              "application/vnd.tcpdump.pcap": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "optionsexportPcap",
        "summary": "CORS preflight",
        "security": [],
        "responses": {
          "204": {
            "description": "Allows GET, POST, OPTIONS; Authorization and Content-Type; origin *."
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "operationId": "getEvents",
        "summary": "Subscribe to future attacked/dropped incident events",
        "tags": [
          "Events"
        ],
        "description": "Serial HTTPServer: this request can block all others and delay shutdown. Queue 100; no event IDs/replay. Keepalive comments roughly every 30 idle seconds. Disconnect before shutdown.",
        "responses": {
          "200": {
            "description": "SSE stream with incident event and JSON Incident data.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "optionsgetEvents",
        "summary": "CORS preflight",
        "security": [],
        "responses": {
          "204": {
            "description": "Allows GET, POST, OPTIONS; Authorization and Content-Type; origin *."
          }
        }
      }
    },
    "/api/v1/docs": {
      "get": {
        "operationId": "getEmbeddedDocs",
        "summary": "Read authenticated embedded HTML help",
        "tags": [
          "Help"
        ],
        "description": "Root / is not a working alias because path normalization strips it. Embedded help contains legacy examples; use the Markdown reference for current behavior.",
        "responses": {
          "200": {
            "description": "HTML help",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Request error. Malformed POST values can also cause a connection failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
